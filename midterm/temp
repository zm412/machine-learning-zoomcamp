def prepare_dicts(df, skills):
    dicts = []
    for _, row in df.iterrows():
        row_dict = {
            'job_role': row['job_role'],
            'experience_(years)': row['experience_(years)'],
            'education': row['education'] 
        }

        candidate_skills = { s.strip().lower() for s in row['skills'].split(',') if s.strip() }

        for skill in skills:
            if skill in candidate_skills:
                row_dict[skill] = 1
        dicts.append(row_dict)

    return dicts

