def get_set_from_string(column, prefix=None):
    if prefix is None:
        prefix = ""

    new_set = set()
    unique_skill_strings = column.unique()
    
    for skills in unique_skill_strings:
        for s in str(skills).split(','):
            cleaned_skill = s.strip().lower().replace(" ", "_")

            if cleaned_skill:
                new_set.add(prefix+cleaned_skill)

    return new_set

